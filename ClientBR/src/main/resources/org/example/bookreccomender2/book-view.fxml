<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import org.example.bookreccomender2.controller.UserManager?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.bookreccomender2.EventHandler"
            stylesheets="@book-view.css"
            prefHeight="600.0" prefWidth="800.0">

    <!-- Barra superiore con pulsante home -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Button fx:id="homeButton" styleClass="home-button" onAction="#switchToHome">
                <graphic>
                    <FontIcon iconLiteral="fas-home" iconSize="20"/>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll-pane">
            <VBox spacing="20.0">
                <!-- Sezione superiore con copertina e dettagli -->
                <HBox spacing="20.0">
                    <!-- Copertina a sinistra -->
                    <StackPane styleClass="cover-container">
                        <ImageView fx:id="coverImage" styleClass="book-cover-image">
                            <Image url="/logoBookRecomender.png"/>
                        </ImageView>
                    </StackPane>


                    <!-- Dettagli del libro e pulsante aggiungi -->
                    <VBox spacing="15.0">
                        <GridPane vgap="10.0" hgap="10.0">
                            <Label text="Titolo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <Label fx:id="titoloLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Autore:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <Label fx:id="autoreLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Editore:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <Label fx:id="editoreLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Anno:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <Label fx:id="annoLabel" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        </GridPane>

                        <Button fx:id="aggiungiLibreriaButton" text="Aggiungi a una libreria"
                                styleClass="action-button" onAction="#addBookToLibrary"/>
                    </VBox>
                </HBox>

                <!-- Sezione valutazione media -->
                <HBox styleClass="average-rating-container" spacing="10.0" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                    </padding>
                    <Label text="Valutazione media:" styleClass="section-label"/>
                    <HBox fx:id="ratingStarsContainer" styleClass="rating-container">
                        <FontIcon iconLiteral="fas-star" fx:id="star1" iconSize="20"/>
                        <FontIcon iconLiteral="fas-star" fx:id="star2" iconSize="20"/>
                        <FontIcon iconLiteral="fas-star" fx:id="star3" iconSize="20"/>
                        <FontIcon iconLiteral="fas-star" fx:id="star4" iconSize="20"/>
                        <FontIcon iconLiteral="fas-star" fx:id="star5" iconSize="20"/>
                    </HBox>
                </HBox>


                <!-- Sezione valutazioni aggregate -->
                <TitledPane text="Valutazioni degli utenti" expanded="true">
                    <VBox fx:id="valutazioniAggregateContainer" spacing="10.0">
                        <!-- Qui andranno i componenti per le statistiche delle valutazioni -->

                    </VBox>
                </TitledPane>


                <!-- Sezione libri consigliati -->
                <TitledPane text="Libri consigliati dagli utenti" expanded="true">
                    <FlowPane fx:id="libriConsigliatiContainer" hgap="10.0" vgap="10.0"/>
                </TitledPane>

                <!-- Pulsanti azioni -->
                <!-- Pulsanti azioni -->
                <HBox spacing="20.0" alignment="CENTER" fx:id="actionButtonsContainer">
                    <Button fx:id="valutaLibroButton" text="Valuta libro"
                            styleClass="action-button" onAction="#addRating"/>
                    <Button fx:id="consigliaLibriButton" text="Consiglia libri simili a questo"
                            styleClass="action-button" onAction="#switchToSuggestedBookList"/>
                </HBox>
            </VBox>

            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
        </ScrollPane>
    </center>
</BorderPane>