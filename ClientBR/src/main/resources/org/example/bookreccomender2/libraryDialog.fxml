<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Dialog di creazione libreria -->
<DialogPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.bookreccomender2.controller.LibraryDialogController"
            prefWidth="400.0" stylesheets="@librarydialog.css">
    <content>
        <VBox spacing="15" alignment="CENTER_LEFT">
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label text="Inserisci il nome della libreria:" styleClass="dialog-label">
                <font>
                    <Font size="14.0"/>
                </font>
            </Label>

            <TextField fx:id="libraryNameField" promptText="Nome libreria" styleClass="dialog-text-field" prefWidth="350.0">
                <font>
                    <Font size="14.0"/>
                </font>
            </TextField>
        </VBox>
    </content>

    <buttonTypes>
        <ButtonType fx:constant="CANCEL"/>
        <ButtonType fx:constant="OK" />
    </buttonTypes>
</DialogPane>