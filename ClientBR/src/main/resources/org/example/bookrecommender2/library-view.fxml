<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.*?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.bookrecommender2.EventHandler"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@library-view.css"
            style="-fx-background-color: -fx-background-light;">

    <top>
        <VBox>
            <!-- Welcome Banner -->
            <VBox alignment="CENTER" spacing="5" styleClass="welcome-banner">
                <Label text="Le mie librerie"
                       styleClass="welcome-text"/>
                <Label text="Organizza e gestisci le tue collezioni di libri preferiti"
                       styleClass="welcome-subtext"/>
            </VBox>

            <!-- Original Top Bar -->
            <HBox alignment="CENTER" spacing="10.0" styleClass="top-bar">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="20.0" left="30.0"/>
                </padding>

                <Button fx:id="homeButton" styleClass="icon-button" onAction="#switchToHome">
                    <graphic>
                        <FontIcon iconLiteral="fas-home" iconSize="18" iconColor="#8B4513"/>
                    </graphic>
                </Button>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <Label fx:id="usernameLabel" styleClass="username-label" text="NOME ACC"/>
                    <StackPane onMouseClicked="#showUserMenu">
                        <Circle fx:id="userAvatar" radius="15" styleClass="user-avatar"/>
                        <FontIcon iconLiteral="fas-user" iconSize="14" iconColor="white"/>
                    </StackPane>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" style="-fx-background-color: transparent;">
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <padding>
                    <Insets top="20.0" right="30.0" bottom="10.0" left="30.0"/>
                </padding>
                <Button fx:id="createLibraryButton"
                        styleClass="create-library-button"
                        onAction="#createNewLibrary">
                    <graphic>
                        <HBox alignment="CENTER" spacing="5">
                            <FontIcon iconLiteral="fas-plus" iconSize="14" iconColor="white"/>
                            <Label text="Crea Libreria" textFill="white">
                                <font>
                                    <Font name="System Bold" size="14.0"/>
                                </font>
                            </Label>
                        </HBox>
                    </graphic>
                    <padding>
                        <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
                    </padding>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true"
                        styleClass="transparent-scroll-pane"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="librariesContainer"
                      alignment="TOP_CENTER"
                      spacing="20.0"
                      styleClass="libraries-container">
                    <padding>
                        <Insets top="10.0" right="30.0" bottom="20.0" left="30.0"/>
                    </padding>
                    <Region prefHeight="10"/>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>